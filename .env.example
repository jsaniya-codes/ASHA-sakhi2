# GEMINI_API_KEY: Required for server-side NFHS-5 District Public Health Policy Briefs.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GNANI_API_KEY: Required for Gnani AI Vachana Speech-to-Text (STT v3) and Timbre v3.0 TTS.
# Configure this via the Secrets panel in the AI Studio UI (server-side only).
GNANI_API_KEY="MY_GNANI_API_KEY"
GNANI_API_BASE_URL="https://api.vachana.ai"
GNANI_STT_MODEL="prisma-v3.0"
GNANI_TTS_MODEL="timbre-v3.0"
GNANI_TTS_VOICE="Lakshmi"

# OPENROUTER_API_KEY: Required for Qwen structured clinical field extraction via OpenRouter.
# Never prefix with VITE_. Server-side only.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
OPENROUTER_QWEN_MODEL="qwen/qwen-2.5-72b-instruct"

# Area Map Tracker uses OpenStreetMap + Leaflet + Nominatim/Photon (no API key required).

# MESSAGING PROVIDERS (Server-side only — never prefix with VITE_):
# Option A: Twilio (supports both SMS and WhatsApp Business via Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# Option B: Meta WhatsApp Business Cloud API
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_CLOUD_PHONE_NUMBER_ID=""

# Option C: Authorized SMS Gateway (HTTP JSON webhook/gateway e.g. MSG91 / Fast2SMS / NIC SMS)
SMS_GATEWAY_URL=""
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
